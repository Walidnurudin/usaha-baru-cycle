// backend/prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MSME_ADMIN
}

enum OrderStatus {
  INQUIRY
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Admin Usaha Baru Cycle")
  role      Role     @default(MSME_ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  description String?  @db.Text
  imageUrl    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model Order {
  id           String      @id @default(cuid())
  customerName String
  customerWa   String
  productName  String
  totalAmount  Decimal     @db.Decimal(12, 2)
  status       OrderStatus @default(INQUIRY)
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([createdAt])
  @@map("orders")
}

model VisitorLog {
  id        String   @id @default(cuid())
  ipHash    String?
  userAgent String?
  visitedAt DateTime @default(now())

  @@index([visitedAt])
  @@map("visitor_logs")
}
